# GrowThisWeek Environment Configuration

# Open-Source Gemma 4 Model via Gemini API (Primary: gemma-4-26b-a4b-it, Fallback: gemma-4-31b-it)
GEMINI_API_KEY=

# Backboard Long-Term Memory (Optional - falls back to local SQLite)
BACKBOARD_API_KEY=

# ElevenLabs Text-to-Speech (Optional - falls back to silent / speech synthesis)
ELEVENLABS_API_KEY=

# Sentry Error Monitoring & Observability (Optional - skips if not set)
SENTRY_DSN=

# App Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
